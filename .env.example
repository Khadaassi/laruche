# ---------------------------------------------------------------------------
# La Ruche — variables d'environnement
# Copier en .env pour le développement local : cp .env.example .env
# NE JAMAIS committer .env ni y mettre une vraie valeur de production ici.
# En production, ces variables sont définies dans l'interface de l'hébergeur.
# ---------------------------------------------------------------------------

# --- Obligatoires -----------------------------------------------------------

# Clé secrète Django (≥ 50 caractères aléatoires). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Domaines autorisés, séparés par des virgules. Jamais '*'.
# Local : localhost,127.0.0.1   Production : laruche.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL PostgreSQL (Neon). Utiliser l'URL « pooled » (hôte en -pooler) avec
# ?sslmode=require. Obligatoire hors DEBUG ; en DEBUG, SQLite local si vide.
#   postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/laruche?sslmode=require
DATABASE_URL=

# --- Développement ----------------------------------------------------------

# true uniquement en local. Désactive Secure sur les cookies, HSTS, la
# redirection HTTPS et exige moins de variables. Jamais en production.
DJANGO_DEBUG=true

# --- Optionnelles (valeurs par défaut sûres) --------------------------------

# Origines de confiance CSRF, avec schéma (nécessaire derrière certains proxys).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://laruche.example.com

# true si un reverse proxy termine TLS et envoie X-Forwarded-Proto.
# DJANGO_BEHIND_PROXY=false

# Redirection HTTP -> HTTPS (défaut : activée hors DEBUG).
# DJANGO_SECURE_SSL_REDIRECT=true

# HSTS (défaut hors DEBUG : 1 an, sous-domaines inclus, preload).
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true

# TLS exigé vers la base (défaut : oui hors DEBUG). false seulement pour un
# Postgres local/CI sans TLS.
# DATABASE_SSL_REQUIRE=true
# DATABASE_CONN_MAX_AGE=60

# Chemin de l'admin (défaut admin/). Un chemin peu devinable réduit le bruit.
# DJANGO_ADMIN_URL=admin/

# DJANGO_LOG_LEVEL=INFO
