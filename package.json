{
  "name": "laruche",
  "version": "0.0.0-development",
  "private": true,
  "description": "La Ruche — outillage front (Tailwind, HTMX, Alpine) et releases",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run vendor && npm run build:css",
    "build:css": "tailwindcss -i assets/css/app.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i assets/css/app.css -o static/css/app.css --watch",
    "vendor": "node scripts/copy-vendor.mjs",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "devDependencies": {
    "@alpinejs/csp": "3.17.4",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "htmx.org": "2.0.11",
    "semantic-release": "25.0.9",
    "tailwindcss": "3.4.19"
  }
}
